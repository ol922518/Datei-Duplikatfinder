#!/bin/zsh
# Startet den Datei-Duplikatfinder ohne sichtbares Terminal-Fenster (echtes
# App-Bundle statt .command-Datei). Pfad zum Projektordner ist bewusst fest
# hinterlegt, damit das Bundle sich z.B. auf den Schreibtisch/ins Dock ziehen
# lässt, ohne die Verknüpfung zum eigentlichen Code zu verlieren.

PROJECT_DIR="/Users/ojo/Claude/Datei-Duplikatfinder"
PYTHON="/opt/homebrew/opt/python@3.14/bin/python3.14"
LOG_FILE="$PROJECT_DIR/.app_launch.log"

cd "$PROJECT_DIR" || exit 1

if [[ ! -x "$PYTHON" ]]; then
    osascript -e 'display alert "Python nicht gefunden" message "Erwartetes Python fehlt unter /opt/homebrew/opt/python@3.14/bin/python3.14 - bitte installieren oder App öffnen.command mit angepasstem Pfad nutzen." as critical'
    exit 1
fi

"$PYTHON" main.py >> "$LOG_FILE" 2>&1
status=$?

if [[ $status -ne 0 ]]; then
    osascript -e "display alert \"Datei-Duplikatfinder abgestürzt\" message \"Details stehen in '.app_launch.log' im Projektordner.\" as critical"
fi
exit $status
